# Plantilla de variables de entorno.
# Copiá este archivo con el nombre .env (en esta misma carpeta, Backend/) y completá los valores reales.
# El .env NUNCA se sube a GitHub: está en el .gitignore.

# Puerto del servidor. Si no se indica, se usa 4000.
PORT=4000

# Conexión a la base de datos MongoDB (local o en Atlas).
MONGO_URI=mongodb://localhost:27017/burgabit

# Clave secreta para firmar y verificar los tokens JWT. Tiene que ser un texto largo y difícil de adivinar.
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta

# Datos del primer administrador. Se crea solo al arrancar el servidor, si todavía no existe ningún admin.
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=BurgaBit
ADMIN_EMAIL=admin@burgabit.com
ADMIN_PASSWORD=cambiar_esta_contrasena